#!/usr/bin/env bash
# sketchybar: aerospace workspace indicator + focused app
# redundant with the daemon wrapper, kept so the script also works run by hand
export PATH="/opt/homebrew/bin:$PATH"

PLUGIN_DIR="$CONFIG_DIR/plugins"

# dont put "SF Pro" here, its not a registered family name and the lookup
# lands on helvetica without saying anything
UI_FONT=".AppleSystemUIFont"

# shellcheck source=plugins/colors.sh
source "$PLUGIN_DIR/colors.sh" # BASE, TEXT, ACCENT

sketchybar --bar height=32 position=top padding_left=8 padding_right=8 color=$BASE

sketchybar --default \
  icon.font="$UI_FONT:Semibold:14.0" \
  label.font="$UI_FONT:Semibold:14.0" \
  icon.color=$TEXT \
  label.color=$TEXT \
  padding_left=4 padding_right=4 \
  label.padding_left=6 label.padding_right=6

sketchybar --add event aerospace_workspace_change

for sid in 1 2 3 4 5 6 7 8 9; do
  sketchybar --add item space.$sid left \
    --subscribe space.$sid aerospace_workspace_change \
    --set space.$sid \
    label="$sid" \
    click_script="aerospace workspace $sid" \
    background.corner_radius=6 \
    background.height=22 \
    background.color=$ACCENT \
    background.drawing=off \
    script="$PLUGIN_DIR/aerospace.sh $sid"
done

sketchybar --add item front_app left \
  --set front_app \
    icon.font="sketchybar-app-font:Regular:16.0" \
    label.font="$UI_FONT:Bold:14.0" \
    script="$PLUGIN_DIR/front_app.sh" \
  --subscribe front_app front_app_switched

sketchybar --update
