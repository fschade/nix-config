--- a/deny-secret-commit.sh
+++ b/deny-secret-commit.sh
@@ -31,6 +31,27 @@
 hook_cwd=$(printf '%s' "$INPUT" | jq -r '.cwd // empty' 2>/dev/null)
 [ -n "$hook_cwd" ] && cd "$hook_cwd" 2>/dev/null
 
+# git runs whatever a repo's config names (core.fsmonitor), and this hook runs
+# outside the sandbox. Only the session project's repos are scanned: the
+# sandbox write-protects their .git/config, any other repo's it does not.
+if ! project=$(cd "${CLAUDE_PROJECT_DIR:-/nonexistent}" 2>/dev/null && pwd -P); then
+  echo "Blocked by the secret-commit guard ($0): CLAUDE_PROJECT_DIR is unset or missing, so the guard cannot tell which repo it may scan. Explain the block to the user." >&2
+  exit 2
+fi
+# keeps git's repo discovery from walking up into a folder the sandbox can write
+export GIT_CEILING_DIRECTORIES="${project%/*}"
+in_project() {
+  case "$1/" in "$project"/*) return 0 ;; esac
+  return 1
+}
+# a real .git folder at the top, neither a gitfile nor pointing elsewhere
+# through commondir, so its config is the write-protected one
+trusted_top() {
+  [ -d "$1/.git" ] && [ ! -L "$1/.git" ] || return 1
+  [ "$(cd "$1" && git rev-parse --absolute-git-dir 2>/dev/null)" = "$1/.git" ] &&
+    [ "$(cd "$1" && git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" = "$1/.git" ]
+}
+
 has_word() {
   printf '%s\n' "$cmd" | grep -qE "(^|[^a-zA-Z0-9_])$1([^a-zA-Z0-9_]|\$)"
 }
@@ -63,9 +84,9 @@
   esac
 }
 resolve_dir() { # $1 = base folder, $2 = folder as written; prints the full path
-  (cd "$1" 2>/dev/null && cd "$(expand_home "$2")" 2>/dev/null && pwd)
+  (cd "$1" 2>/dev/null && cd "$(expand_home "$2")" 2>/dev/null && pwd -P)
 }
-start=$(pwd)
+start=$(pwd -P)
 candidates=$start
 c_base=$start
 cd_dir=$(printf '%s\n' "$cmd" | sed -nE "1s/^[[:space:]]*cd[[:space:]]+${DIR_RE}[[:space:]]*(&&|;).*/\\2\\3\\4/p")
@@ -84,7 +105,9 @@
 # subfolder, gitleaks only looks at that subfolder's changes, and reads its
 # settings files from there.
 tops=$(printf '%s\n' "$candidates" | while IFS= read -r d; do
-  (cd "$d" 2>/dev/null && git rev-parse --show-toplevel 2>/dev/null)
+  in_project "$d" || continue
+  top=$(cd "$d" 2>/dev/null && git rev-parse --show-toplevel 2>/dev/null) || continue
+  in_project "$top" && trusted_top "$top" && printf '%s\n' "$top"
 done | sort -u)
 [ -n "$tops" ] || exit 0
 
@@ -255,7 +278,7 @@
       # --pipe` ignores the pipe and scans the whole folder, git-ignored
       # build output included.
       report=$({
-        git diff --no-ext-diff --no-color -U0 | sed -n 's/^+//p'
+        git diff --no-ext-diff --ignore-submodules=all --no-color -U0 | sed -n 's/^+//p'
         git ls-files --others --exclude-standard -z -- ':/' | xargs -0 cat --
       } 2>/dev/null | gitleaks stdin $GITLEAKS_FLAGS 2>&1)
       rc=$?
