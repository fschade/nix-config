{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opus[1m]",
  "effortLevel": "medium",
  "autoCompactWindow": 200000,
  "enableArtifact": false,
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "skipWorkflowUsageWarning": true,
  "skillOverrides": {
    "batch": "off",
    "claude-api": "off",
    "dataviz": "off",
    "deep-research": "user-invocable-only",
    "debug": "user-invocable-only",
    "design": "off",
    "design-sync": "off",
    "doctor": "user-invocable-only",
    "fewer-permission-prompts": "off",
    "keybindings-help": "off",
    "run-skill-generator": "off",
    "schedule": "off",
    "update-config": "off"
  },
  "enabledPlugins": {
    "cc-plugin-plugin-authoring@builtin": false
  },
  "theme": "dark",
  "switchModelsOnFlag": false,
  "cleanupPeriodDays": 365,
  "worktree": {
    "baseRef": "head"
  },
  "enableAllProjectMcpServers": false,
  "lspServers": {
    "sourcekit-lsp": {
      "command": "sourcekit-lsp",
      "extensionToLanguage": {
        ".swift": "swift"
      }
    }
  },
  "env": {
    "DISABLE_TELEMETRY": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_AUTOUPDATER": "1",
    "CLAUDE_CODE_DISABLE_OFFICIAL_MARKETPLACE_AUTOINSTALL": "1",
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "autoAllowBashIfSandboxed": false,
    "allowUnsandboxedCommands": false,
    "excludedCommands": [
      "gh pr view *",
      "gh pr list *",
      "gh pr diff *",
      "gh pr checks *",
      "gh issue view *",
      "gh issue list *",
      "gh run view *",
      "gh run list *",
      "gh workflow run *",
      "gh run rerun *"
    ],
    "filesystem": {
      "allowWrite": [
        "~/.cache",
        "~/Library/Caches"
      ],
      "denyWrite": [
        "~/**/.claude/outbound-hosts",
        "~/**/.claude/ssh-hosts"
      ],
      "denyRead": [
        "~/**/.env",
        "~/**/.env.*",
        "~/**/id_rsa",
        "~/**/id_ecdsa",
        "~/**/id_ed25519",
        "~/**/credentials.json",
        "~/**/*.pem",
        "~/**/*.key",
        "~/**/.pgpass"
      ],
      "allowRead": [
        "~/**/.env.dist",
        "~/**/.env.example",
        "~/**/.env.sample",
        "~/**/.env.template",
        "~/**/*cert.pem",
        "~/**/ca.pem"
      ]
    },
    "network": {
      "strictAllowlist": true,
      "allowLocalBinding": true,
      "allowedDomains": [
        "localhost",
        "*.localhost",
        "127.0.0.1",
        "[::1]",
        "*.test",
        "host.docker.internal",
        "github.com",
        "api.github.com",
        "codeload.github.com",
        "raw.githubusercontent.com",
        "objects.githubusercontent.com",
        "release-assets.githubusercontent.com",
        "registry.npmjs.org",
        "pypi.org",
        "files.pythonhosted.org",
        "crates.io",
        "index.crates.io",
        "static.crates.io",
        "proxy.golang.org",
        "sum.golang.org",
        "cache.nixos.org"
      ]
    },
    "credentials": {
      "files": [
        {"path": "~/.ssh", "mode": "deny"},
        {"path": "~/.aws", "mode": "deny"},
        {"path": "~/.config/gh", "mode": "deny"},
        {"path": "~/.netrc", "mode": "deny"},
        {"path": "~/.git-credentials", "mode": "deny"},
        {"path": "~/.npmrc", "mode": "deny"},
        {"path": "~/.docker/config.json", "mode": "deny"},
        {"path": "~/.kube", "mode": "deny"},
        {"path": "~/.gnupg", "mode": "deny"},
        {"path": "~/.config/sops", "mode": "deny"},
        {"path": "~/Library/Keychains", "mode": "deny"}
      ],
      "envVars": [
        {"name": "GH_TOKEN", "mode": "deny"},
        {"name": "GITHUB_TOKEN", "mode": "deny"},
        {"name": "NPM_TOKEN", "mode": "deny"},
        {"name": "SSH_AUTH_SOCK", "mode": "deny"}
      ]
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/bash-guard.sh"
          }
        ]
      },
      {
        "matcher": "WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/webfetch-guard.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/test-guard.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/cc-safety-net hook --coding-cli"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/audit-log.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/herdr-agent-state.sh session",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/stop-recheck.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "sh ~/.claude/statusline-command.sh"
  },
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git show)",
      "Bash(git show *)",
      "Bash(git blame *)",
      "Bash(git branch)",
      "Bash(git branch -a)",
      "Bash(git branch --show-current)",
      "Bash(git remote -v)",
      "Bash(git stash list)",
      "Bash(git worktree list)",
      "Bash(ls)",
      "Bash(ls *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(jq *)",
      "Bash(nix flake check)",
      "Bash(nix flake check *)",
      "Bash(nix flake show)",
      "Bash(nix flake show *)",
      "Bash(nix flake metadata)",
      "Bash(mise tasks)",
      "Bash(mise tasks *)",
      "Bash(mise ls)"
    ],
    "ask": [
      "Bash(ssh *)",
      "Bash(autossh *)",
      "Bash(mosh *)",
      "Bash(scp *)",
      "Bash(sftp *)",
      "Bash(rsync *)"
    ],
    "deny": [
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(sudo *)",
      "Bash(mkfs *)",
      "mcp__claude-in-chrome__form_input",
      "mcp__claude-in-chrome__file_upload",
      "mcp__claude-in-chrome__upload_image",
      "mcp__claude-in-chrome__javascript_tool",
      "mcp__idea__execute_terminal_command",
      "mcp__idea__execute_run_configuration",
      "mcp__idea__execute_sql_query",
      "mcp__idea__execute_code_on_kernel",
      "mcp__idea__run_notebook_cell",
      "mcp__idea__xdebug_evaluate_expression",
      "mcp__idea__run_inspection_kts",
      "mcp__idea__invoke_ide_action",
      "mcp__idea__execute_tool",
      "Bash(ssh *ProxyCommand*)",
      "Bash(ssh *LocalCommand*)",
      "Bash(ssh * -F*)",
      "Bash(autossh *ProxyCommand*)",
      "Bash(autossh *LocalCommand*)",
      "Bash(autossh * -F*)",
      "Bash(sftp *ProxyCommand*)",
      "Bash(sftp * -F*)",
      "Bash(scp *ProxyCommand*)",
      "Bash(scp -F*)",
      "Bash(scp * -F*)",
      "Bash(rsync *ProxyCommand*)",
      "Bash(rsync -e*)",
      "Bash(rsync * -e*)",
      "Bash(rsync --rsh*)",
      "Bash(rsync * --rsh*)",
      "Read(**/credentials.json)",
      "Read(**/*.key)",
      "Read(**/.pgpass)",
      "Edit(~/.claude/settings.json)",
      "Edit(~/.claude/CLAUDE.md)",
      "Edit(~/.claude/statusline-command.sh)",
      "Edit(~/.cc-safety-net/**)",
      "Edit(~/.agents/**)",
      "Edit(~/.claude/skills/**)",
      "Edit(~/.claude/agents/**)",
      "Edit(~/.claude/commands/**)",
      "Edit(~/.claude/plugins/**)",
      "Edit(**/.claude/ssh-hosts)",
      "Edit(**/.claude/outbound-hosts)",
      "Edit(**/.claude/settings.json)",
      "Edit(**/.claude/settings.local.json)"
    ],
    "disableBypassPermissionsMode": "disable"
  }
}
