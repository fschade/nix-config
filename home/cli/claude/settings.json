{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opus",
  "effortLevel": "medium",
  "autoCompactWindow": 200000,
  "enableArtifact": false,
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "skipWorkflowUsageWarning": true,
  "skillOverrides": {
    "batch": "off",
    "claude-api": "off",
    "dataviz": "off",
    "deep-research": "user-invocable-only",
    "debug": "user-invocable-only",
    "design": "off",
    "design-sync": "off",
    "doctor": "user-invocable-only",
    "fewer-permission-prompts": "off",
    "keybindings-help": "off",
    "run-skill-generator": "off",
    "schedule": "off",
    "update-config": "off"
  },
  "enabledPlugins": {
    "cc-plugin-plugin-authoring@builtin": false
  },
  "theme": "dark",
  "switchModelsOnFlag": false,
  "cleanupPeriodDays": 365,
  "worktree": {
    "baseRef": "head"
  },
  "env": {
    "DISABLE_ERROR_REPORTING": "1",
    "CLAUDE_CODE_DISABLE_OFFICIAL_MARKETPLACE_AUTOINSTALL": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet",
    "NODE_USE_ENV_PROXY": "1"
  },
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/cc-safety-net hook --coding-cli"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/secret-guard",
            "timeout": 60
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/herdr-agent-state.sh session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "best-claude-hud"
  },
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "allowWrite": [
        "~/.cache",
        "~/Library/Caches",
        "~/go/pkg",
        "~/.local/share/pnpm"
      ],
      "denyRead": [
        "~/**/.env",
        "~/**/.env.*"
      ],
      "allowRead": [
        "~/**/.env.example",
        "~/**/.env.dist",
        "~/**/.env.sample",
        "~/**/.env.template"
      ]
    },
    "network": {
      "allowLocalBinding": true,
      "allowMachLookup": [
        "com.apple.trustd.agent"
      ],
      "allowUnixSockets": [
        "/nix/var/nix/daemon-socket/socket",
        "/private/var/run/nix-daemon.socket"
      ],
      "allowedDomains": [
        "localhost",
        "*.localhost",
        "127.0.0.1",
        "[::1]",
        "*.test",
        "host.docker.internal",
        "github.com",
        "api.github.com",
        "codeload.github.com",
        "raw.githubusercontent.com",
        "objects.githubusercontent.com",
        "release-assets.githubusercontent.com",
        "registry.npmjs.org",
        "pypi.org",
        "files.pythonhosted.org",
        "proxy.golang.org",
        "sum.golang.org",
        "cache.nixos.org",
        "context7.com"
      ]
    }
  },
  "permissions": {
    "allow": [
      "Bash(rg *)",
      "Bash(jq *)",
      "Bash(mise tasks *)",
      "Bash(mise ls *)"
    ],
    "deny": [
      "Bash(git push *)",
      "Bash(sudo *)",
      "mcp__idea",
      "Read(~/**/credentials.json)",
      "Read(~/**/.pgpass)",
      "Read(~/**/*.agekey)",
      "Read(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.aws/**)",
      "Read(~/.kube/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.config/sops/**)",
      "Read(~/.docker/config.json)",
      "Read(~/.git-credentials)",
      "Read(~/.netrc)",
      "Read(~/.npmrc)",
      "Read(~/Library/Keychains/**)",
      "Read(~/.talos/**)",
      "Read(~/Library/Application Support/Bitwarden CLI/**)",
      "Read(~/.local/share/atuin/**)",
      "Read(~/**/.env)",
      "Read(~/**/.env.local)",
      "Edit(~/.ssh/**)",
      "Edit(~/**/credentials.json)",
      "Edit(~/**/.pgpass)",
      "Edit(~/**/*.agekey)",
      "Edit(~/.gnupg/**)",
      "Edit(~/.aws/**)",
      "Edit(~/.kube/**)",
      "Edit(~/.config/gh/**)",
      "Edit(~/.config/sops/**)",
      "Edit(~/.docker/config.json)",
      "Edit(~/.git-credentials)",
      "Edit(~/.netrc)",
      "Edit(~/.npmrc)",
      "Edit(~/Library/Keychains/**)",
      "Edit(~/.talos/**)",
      "Edit(~/Library/Application Support/Bitwarden CLI/**)",
      "Edit(~/.local/share/atuin/**)",
      "Edit(~/.claude/settings.json)",
      "Edit(~/.claude/CLAUDE.md)",
      "Edit(~/.cc-safety-net/**)",
      "Edit(**/.claude/settings*.json)"
    ],
    "disableBypassPermissionsMode": "disable"
  }
}
