{
  "version": 1,
  "safety": {
    "level": "standard",
    "overrides": {}
  },
  "workflow": {
    "worktree_mode": true
  },
  "destructive_command_protection": {
    "enabled": true,
    "overrides": {
      "git.stash-drop": "off",
      "git.branch-force-delete": "off",
      "git.worktree-remove-force": "off"
    },
    "allow_paths": []
  },
  "secret_protection": {
    "enabled": true,
    "overrides": {},
    "deny_paths": [],
    "allow_paths": []
  },
  "audit": {
    "retention_days": 30
  }
}
