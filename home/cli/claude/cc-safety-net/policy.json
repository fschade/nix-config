{
  "version": 1,
  "safety": {
    "level": "standard",
    "overrides": {
      "paranoid_rm": true
    }
  },
  "destructive_command_protection": {
    "overrides": {
      "network.upload-remote": "off"
    }
  },
  "secret_protection": {
    "deny_paths": [
      "~/.gnupg",
      "~/.config/sops",
      "~/.kube",
      "~/Library/Keychains"
    ],
    "allow_paths": [
      ".env.dist"
    ]
  }
}
