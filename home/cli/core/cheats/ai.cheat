% ai, docs, claude, workflow

# Read a doc: workflow (which step in which order)
glow -p <doc>

$ doc: printf '%s\t%s\n' workflow ~/.claude/rules/workflow.md --- --column 2 --delimiter '\t' --prevent-extra --preview 'glow -s dark -w "$FZF_PREVIEW_COLUMNS" {2}'

% ai, guards, claude

# How cc-safety-net judges a command, step by step
cc-safety-net explain "<cmd>"

# Recent cc-safety-net denials
cc-safety-net logs

# cc-safety-net denials that look like false positives
cc-safety-net logs --suspect
