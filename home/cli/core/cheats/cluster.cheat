% cluster, kubernetes, k8s

# List contexts (current is marked)
kubectl config get-contexts

# Switch context
kubectl config use-context <context>

# Pods across all namespaces, wide
kubectl get pods -A -o wide

# Describe a pod
kubectl describe pod <pod>

# Follow a pod's logs
kubectl logs -f <pod>

# Shell into a pod
kubectl exec -it <pod> -- <shell>

# Port-forward a service to localhost
kubectl port-forward svc/<service> <localport>:<remoteport>

# Resource usage by pod
kubectl top pods -A

# homelab: one-screen cluster health
task ops:status

# homelab: alerts firing right now
task ops:alerts

# homelab: what fired lately and how often (prometheus keeps 10d)
task ops:alerts:history -- <days>

# homelab: logs from loki, also for pods that are already deleted
task ops:logs -- <namespace> <pod_prefix> <hours>

# homelab: backup cronjobs with schedule and last success
task ops:backup:status

# homelab: versions in the off-site bucket, delete markers included
task ops:b2:versions -- <prefix>
