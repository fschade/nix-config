% docs, help

# Quick offline examples for a command (tldr)
tldr <command>

# Community docs / wiki for a command (cht.sh, online)
cht.sh <command>

# Search a command's cheat sheet for a keyword (cht.sh)
cht.sh <command>~<keyword>

# Full manual page
man <command>

# What is this command + where does it live
type -a <command>
