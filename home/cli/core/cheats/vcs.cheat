% vcs, git, history

# Undo last commit, keep changes staged
git reset --soft HEAD~1

# Amend the last commit without editing the message
git commit --amend --no-edit

# Discard all local changes and match remote
git reset --hard <remote>/<branch>

# Delete local branches already merged into HEAD
git branch --merged | grep -vE '^\*|^[[:space:]]*(main|master)$' | xargs -r git branch -d

# Interactively rebase the last N commits
git rebase -i HEAD~<n>

# Show files changed in the last commit
git show --stat

# Local branches with their push and fetch upstreams
git for-each-ref --format='%(refname:short)|%(push:short)|%(upstream:short)' refs/heads/ \
    | awk -F'|' '{printf "%-40s push=%-45s fetch=%s\n", $1, ($2==""?"-":$2), ($3==""?"-":$3)}'

# Push target of the current branch
git rev-parse --abbrev-ref '@{push}'

# First push of a new branch, pick the remote yourself (nothing sets an upstream for you)
git push -u <remote> HEAD

; branch interpolates $remote, so it only resolves after the remote pick
; navi pastes values raw into the shell and remotes pick their branch names, hence --map
$ remote: git remote
$ branch: git branch --remotes --list "$remote/*" --format '%(refname:lstrip=3)' | grep -v '^HEAD$' --- --map 'IFS= read -r v; printf %q "$v"'

% vcs, git, branches

# Branch convention: <type>/<issue>-<description>, types feat fix chore docs refactor test ci release hotfix, lowercase, hyphens
git branches --check

# Report the branches of this repo that are off: gone, merged, behind, ahead, local (never pushed), name
git branches

# The same report over every repo under ~/Developer
git branches --all

# Delete local branches whose GitHub PR is merged, dry run first (squash merges count, it asks the api)
gh poi --dry-run

# Delete local branches whose GitHub PR is merged
gh poi

# Delete local branches whose upstream is gone but no merge was detected (dry run)
git trim --delete stray --dry-run

# Rename a local branch onto the convention
git branch -m <local> <type>/<name>

# Lefthook pre-push gate for the convention, add to a project's lefthook.yml
printf 'pre-push:\n  commands:\n    branch-name:\n      run: git branches --check\n'

$ local: git for-each-ref --format '%(refname:short)' refs/heads/ --- --map 'IFS= read -r v; printf %q "$v"'
$ type: printf 'feat\nfix\nchore\ndocs\nrefactor\ntest\nci\nrelease\nhotfix\n'
