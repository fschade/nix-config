% nix

# Garbage-collect: drop old generations, then collect (from the nix-config checkout)
mise run gc

# Evaluate a flake output
nix eval <flake>#<attr>

# Update a single flake input
nix flake update <input>

# Run a program from nixpkgs without installing
nix run nixpkgs#<pkg>

# Search nixpkgs
nix search nixpkgs <query>
